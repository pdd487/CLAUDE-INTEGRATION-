# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Without it, assembleRelease signs with the debug key so the APK still installs.
#
# Create a key once:
#   keytool -genkeypair -v -keystore qwikshot-release.jks -alias qwikshot \
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=qwikshot-release.jks
storePassword=change-me
keyAlias=qwikshot
keyPassword=change-me
